      "css": ".ds-tabs{display:grid;grid-template-columns:repeat(4,1fr);height:56px;border-top:1px solid var(--color-line,#e6e3dc);background:#fff}.ds-tabs a{display:grid;place-items:center;font-size:11px;color:var(--color-ink-3,#5b6270);text-decoration:none}.ds-tabs a[aria-current=page]{color:var(--color-sign,#1f4fa3);font-weight:700;box-shadow:inset 0 3px 0 var(--color-sign,#1f4fa3)}.ds-tabs a:focus-visible{outline:2px solid var(--color-sign,#1f4fa3);outline-offset:2px}"
