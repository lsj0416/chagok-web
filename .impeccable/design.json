  "components": [
    {
      "name": "안내판 띠",
      "kind": "nav",
      "refersTo": "sign-band",
      "description": "모든 화면의 머리. 파랑 띠, 흰 Do Hyeon 제목, 아래 3px 노랑 줄.",
      "html": "<header class=\"ds-sign\"><div class=\"ds-sign-row\"><h1 class=\"ds-sign-title\">10월 28일 수요일</h1></div><p class=\"ds-sign-sub\"><span class=\"ds-sign-num\">핵심 1/3</span> 오늘 2/8 완료</p></header>",
      "css": ".ds-sign{background:var(--color-sign,#1f4fa3);color:var(--color-sign-ink,#fff);border-bottom:3px solid var(--color-caution,#f2c230)}.ds-sign-row{display:flex;align-items:center;min-height:56px;padding:0 8px 0 20px}.ds-sign-title{margin:0;font-family:var(--font-display,'Do Hyeon'),sans-serif;font-weight:400;font-size:22px;line-height:1.375}.ds-sign-sub{margin:-4px 0 0;padding:0 20px 12px;font-size:14px;color:var(--color-sign-2,#d5e1f6);display:flex;align-items:baseline;gap:12px}.ds-sign-num{font-family:var(--font-display,'Do Hyeon'),sans-serif;font-size:22px;line-height:1;color:var(--color-sign-ink,#fff)}"
    },
    {
      "name": "하단 대표 버튼",
      "kind": "button",
      "refersTo": "button-primary-bar",
      "description": "먹색, 각진 모서리, 4px 노랑 아래 줄, Do Hyeon 19px.",
      "html": "<button class=\"ds-btn-bar\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M12 5v14\"/></svg>할 일 추가</button>",
      "css": ".ds-btn-bar{display:flex;align-items:center;justify-content:center;gap:6px;width:100%;height:52px;border:0;border-bottom:4px solid var(--color-caution,#f2c230);border-radius:0;background:var(--color-ink,#18202b);color:#fff;font-family:var(--font-display,'Do Hyeon'),sans-serif;font-size:19px;cursor:pointer}.ds-btn-bar:focus-visible{outline:2px solid var(--color-sign,#1f4fa3);outline-offset:2px}.ds-btn-bar:disabled{opacity:.4}"
    },
    {
      "name": "본문 먹색 버튼",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "본문 안 대표 행동. 3px 노랑 아래 줄.",
      "html": "<button class=\"ds-btn-primary\">다시 시도</button>",
      "css": ".ds-btn-primary{height:44px;padding:0 16px;border:0;border-bottom:3px solid var(--color-caution,#f2c230);border-radius:0;background:var(--color-ink,#18202b);color:#fff;font-size:14px;font-weight:600;cursor:pointer}.ds-btn-primary:focus-visible{outline:2px solid var(--color-sign,#1f4fa3);outline-offset:2px}.ds-btn-primary:disabled{opacity:.4}"
    },
    {
